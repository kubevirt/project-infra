FROM registry.fedoraproject.org/fedora:latest

RUN yum -y update && \
  yum install -y npm && \
  yum clean all && \
  rm -rf /var/cache/yum/*
RUN yum install -y python3 && yum clean all && rm -rf /var/cache/yum/*
RUN mkdir -p /usr/local/bin && \
    printf '%s' \
      '' \
      '' \
      '' \
      '' \
      '' \
      '' \
      '' \
      '' \
      '' \
      '' \
      '' \
      '' \
      '' \
      'IHBhc3MKCiAgICByZXR1cm4gMSBpZiBleGl0X2lzc3VlcyBlbHNlIDAKCgppZiBfX25hbWVfXyA9PSAiX19tYWluX18iOgogICAgc3lzLmV4aXQobWFpbigpKQo=' \
      | base64 -d > /usr/local/bin/yaspeller && chmod 755 /usr/local/bin/yaspeller && \
    npm install -g --prefix /usr/local cspell@10.4.0 && \
    yum remove -y npm && yum clean all && rm -rf /var/cache/yum/*
