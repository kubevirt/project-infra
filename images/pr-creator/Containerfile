FROM --platform=${BUILDPLATFORM} quay.io/kubevirtci/golang:v20261116-94a0485 AS builder

ARG TARGETOS
ARG TARGETARCH

ENV GOPROXY=https://proxy.golang.org|direct \
    GOFLAGS="-mod=vendor -ldflags=-extldflags=\"-static\"" \
    CGO_ENABLED=0
ENV GIMME_GO_VERSION=1.25.1

RUN set -x && \
    git clone --depth 1 --revision 03e5768a447b55381f7517a9d27bb51831893d31 https://github.com/kubernetes/test-infra.git && \
    cd ./test-infra && \
    /usr/local/bin/runner.sh /bin/sh -cex ' \
        export GOOS=${TARGETOS} GOARCH=${TARGETARCH}; \
        go mod vendor; \
        time go build -tags netgo -o /usr/local/bin/pr-creator ./robots/pr-creator; \
    ' && \
    chmod +x /usr/local/bin/pr-creator

RUN set -x && \
    cd /project-infra && \
    /usr/local/bin/runner.sh /bin/sh -cex ' \
        export GOOS=${TARGETOS} GOARCH=${TARGETARCH}; \
        time go build -tags netgo -o /usr/local/bin/labels-checker ./robots/labels-checker; \
    ' && \
    chmod +x /usr/local/bin/labels-checker

FROM --platform=${TARGETPLATFORM} quay.io/kubevirtci/golang:v20261116-94a0485

RUN dnf install -y \
    skopeo && \
    dnf -y clean all

COPY --from=builder /usr/local/bin/pr-creator /usr/local/bin/
COPY --from=builder /usr/local/bin/labels-checker /usr/local/bin/

RUN set -x && \
    cd /project-infra && \
    cp ./hack/git-askpass.sh ./hack/git-pr.sh /usr/local/bin && \
    chmod +x /usr/local/bin/git-askpass.sh /usr/local/bin/git-pr.sh

ENV GIT_ASKPASS=/usr/local/bin/git-askpass.sh

